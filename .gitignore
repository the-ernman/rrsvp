# Rust build output
/target
**/target/

# Editor / OS
.DS_Store
.vscode/settings.json
*.swp

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# ESP-IDF auto-generated sdkconfig (edit sdkconfig.defaults instead)
**/sdkconfig
!**/sdkconfig.defaults

# ESP-IDF managed components (downloaded at build time)
**/managed_components/
**/dependencies.lock

# Compiled firmware artefacts
*.elf
*.bin
*.map
*.hex

.embuild
